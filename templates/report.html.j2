<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Android Security Lab · {{ report.session.session_id }}</title>
  <style>
    body { font: 15px/1.5 system-ui, sans-serif; color: #172033; margin: 2rem auto; max-width: 1100px; padding: 0 1rem; }
    h1, h2 { color: #0f172a; } table { width: 100%; border-collapse: collapse; margin: 1rem 0 2rem; }
    th, td { text-align: left; vertical-align: top; border: 1px solid #d8dee9; padding: .55rem; }
    th { background: #f1f5f9; } code { overflow-wrap: anywhere; }
    .confirmed { color: #b91c1c; } .potential { color: #a16207; } .pass { color: #15803d; }
    .meta { color: #526174; } .warning { background: #fff7ed; padding: .8rem; border-left: 4px solid #f97316; }
  </style>
</head>
<body>
  <h1>Android Security Lab Report</h1>
  <p class="meta">Generated {{ report.generated_at }} · Session <code>{{ report.session.session_id }}</code></p>
  <p class="warning">Raw evidence may contain sensitive lab data. HTML values are redacted or bounded, but review before sharing.</p>

  <h2>Executive summary</h2>
  <p>Package <code>{{ report.session.package }}</code> on {{ report.device.device.model or 'unknown device' if report.device else 'unknown device' }}.</p>
  <table>
    <tr><th>Security rules evaluated</th><th>Security findings</th><th>Runtime checks</th><th>Runtime observations</th><th>Total checks</th></tr>
    <tr><td>{{ report.summary.security_rules_evaluated }}</td><td>{{ report.summary.security_findings_total }}</td><td>{{ report.summary.runtime_checks_executed }}</td><td>{{ report.summary.runtime_observations_total }}</td><td>{{ report.summary.total_checks_executed }}</td></tr>
  </table>
  <table>
    <tr><th>Confirmed</th><th>Potential</th><th>Pass</th><th>Inconclusive</th><th>Skipped</th><th>Error</th></tr>
    <tr><td>{{ report.summary.confirmed }}</td><td>{{ report.summary.potential }}</td><td>{{ report.summary.pass }}</td><td>{{ report.summary.inconclusive }}</td><td>{{ report.summary.skipped }}</td><td>{{ report.summary.error }}</td></tr>
  </table>
  <p>Wall-clock: {{ report.summary.wall_clock_duration_ms or report.summary.assessment_duration_ms }} ms · module duration sum: {{ report.summary.sum_of_module_durations_ms }} ms · report={{ report.report_state }}.</p>

  <h2>Scope and runtime</h2>
  <table>
    <tr><th>Package</th><td><code>{{ report.session.package }}</code></td></tr>
    <tr><th>Device</th><td>{{ report.session.serial_masked }}</td></tr>
    <tr><th>App version</th><td>{{ report.app.metadata.version_name if report.app and report.app.metadata else '-' }}</td></tr>
    <tr><th>Root available</th><td>{{ report.root_available }}</td></tr>
    <tr><th>Root used in session</th><td>{{ report.root_used_in_session }}</td></tr>
    <tr><th>Root used by findings</th><td>{{ report.root_used_by_findings }}</td></tr>
    <tr><th>Frida available</th><td>{{ report.frida_available }}</td></tr>
    <tr><th>Frida used in session</th><td>{{ report.frida_used_in_session }}</td></tr>
    <tr><th>Frida used by findings</th><td>{{ report.frida_used_by_findings }}</td></tr>
    <tr><th>Environment type</th><td>{{ report.experiment.environment_type }}</td></tr>
    <tr><th>Evidence source</th><td>{{ report.evidence_source }}</td></tr>
    <tr><th>Emulator validation</th><td>{{ report.experiment.emulator_validation }}</td></tr>
    <tr><th>Physical-device validation</th><td>{{ report.experiment.physical_device_validation }}</td></tr>
    <tr><th>Cleanup</th><td>{{ report.cleanup.status }}; success={{ report.cleanup.success }}; pending={{ report.cleanup.pending }}</td></tr>
  </table>

  <h2>Module execution coverage</h2>
  <table>
    <thead><tr><th>Module</th><th>Planned</th><th>Executed</th><th>Result</th><th>Wall duration</th><th>Evidence</th><th>Events/items</th><th>Findings</th><th>Skip/no-data reason</th></tr></thead>
    <tbody>{% for item in report.module_execution_coverage %}<tr><td>{{ item.module }}</td><td>{{ item.planned }}</td><td>{{ item.executed }}</td><td>{{ item.result }}</td><td>{{ item.duration_ms or '-' }} ms</td><td>{{ item.evidence }}</td><td>{{ item.event_item_count }}</td><td>{{ item.findings_produced }}</td><td>{{ item.skip_reason or '-' }}</td></tr>{% endfor %}</tbody>
  </table>

  <h2>Runtime checks and observations</h2>
  {% if report.runtime_checks %}<table><thead><tr><th>Rule</th><th>Observation status</th><th>Events/items</th><th>Security finding</th><th>Reason</th></tr></thead><tbody>{% for item in report.runtime_checks %}<tr><td><code>{{ item.rule_id }}</code></td><td>{{ item.observation_status }}</td><td>{{ item.details.event_count or item.details.observation_count or 0 }}</td><td>no</td><td>{{ item.reason }}</td></tr>{% endfor %}</tbody></table>{% endif %}
  {% if report.runtime_observations %}<table><thead><tr><th>Category</th><th>Method</th><th>Status</th><th>Events</th><th>Finding link</th></tr></thead><tbody>{% for item in report.runtime_observations %}<tr><td>{{ item.category }}</td><td>{{ item.method }}</td><td>{{ item.status }}</td><td>{{ item.event_count }}</td><td>{{ item.finding_id or '-' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>No runtime event was recorded.</p>{% endif %}

  <h2>Findings and coverage</h2>
  <table>
    <thead><tr><th>Rule</th><th>Status</th><th>Title</th><th>Method</th><th>Detection / activation</th><th>Validation</th><th>Evidence</th><th>Remediation</th></tr></thead>
    <tbody>
    {% for finding in report.findings %}
      <tr>
        <td><code>{{ finding.rule_id }}</code><br>{{ finding.severity }} / {{ finding.confidence }}</td>
        <td class="{{ finding.status }}">{{ finding.status }}</td>
        <td>{{ finding.title }}<br><small>{{ finding.description }}</small></td>
        <td>{{ finding.analysis_type }}<br><small>root={{ finding.root_used }}, frida={{ finding.frida_used }}, validation={{ finding.validation_type }}</small></td>
        <td><small>{{ finding.details.reason or '-' }}</small>{% if finding.details.ipc_validation %}<br><small>activation={{ finding.details.ipc_validation.activation_state }}, validation={{ finding.details.ipc_validation.validation_state }}, reached={{ finding.details.ipc_validation.runtime_reached }}</small>{% if finding.details.ipc_validation.auto_validation_blocker %}<br><small>blocker={{ finding.details.ipc_validation.auto_validation_blocker | join('; ') }}</small>{% endif %}{% endif %}{% if finding.details.missing_evidence %}<br><small>missing={{ finding.details.missing_evidence | join('; ') }}</small>{% endif %}</td>
        <td>{% if finding.validation %}{{ finding.validation.status }} · {{ finding.validation.validation_type }}<br>{{ finding.validation.summary }}{% else %}-{% endif %}</td>
        <td>{% for evidence_id in finding.evidence_ids %}<code>{{ evidence_id }}</code><br>{% endfor %}</td>
        <td>{{ finding.remediation }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if report.suppressed_findings %}<p class="meta">Aggregate/alias rows suppressed from finding totals: {% for item in report.suppressed_findings %}<code>{{ item.rule_id }}</code> {% endfor %}</p>{% endif %}

  <h2>Root vs non-root coverage</h2>
  <table>
    <thead><tr><th>Test</th><th>Without root</th><th>With root</th><th>Frida</th><th>Implementation</th><th>Physical validation</th><th>Finding</th></tr></thead>
    <tbody>
    {% for item in report.root_vs_non_root_coverage %}
      <tr><td><code>{{ item.test_id }}</code></td><td>{{ item.available_without_root }}</td><td>{{ item.available_with_root }}</td><td>{{ item.requires_frida }}</td><td>{{ item.implementation_status }}</td><td>{{ item.physical_validation_status }}</td><td>{{ item.finding_status }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Evidence index</h2>
  <table>
    <thead><tr><th>ID</th><th>Type</th><th>Path</th><th>SHA-256</th><th>Sensitive / redacted</th></tr></thead>
    <tbody>
    {% for item in report.evidence %}
      <tr><td><code>{{ item.evidence_id }}</code></td><td>{{ item.evidence_type }}</td><td><code>{{ item.relative_path }}</code></td><td><code>{{ item.sha256 }}</code></td><td>{{ item.sensitive }} / {{ item.redacted }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Preconditions, cleanup, and limitations</h2>
  <p>ADB authorization was required. Root and Frida use are recorded per finding. Root-assisted observations do not by themselves establish an application vulnerability.</p>
  {% if report.limitations %}<ul>{% for item in report.limitations %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<p>No framework limitation was recorded for this run.</p>{% endif %}
</body>
</html>
